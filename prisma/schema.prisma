// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchants {
  id              Int               @id @default(autoincrement())
  username        String            @unique
  password        String
  firstName       String            @map("first_name")
  lastName        String            @map("last_name")
  email           String
  Screens         Screens[]
  WooCommerceKeys WooCommerceKeys[]

  @@map("merchants")
}

model Users {
  id        Int    @id @default(autoincrement())
  password  String
  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique

  @@map("users")
}

model WooCommerceKeys {
  id         Int       @id @default(autoincrement())
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")

  @@map("wooCommerceKeys")
}

model Screens {
  id         Int       @id @default(autoincrement())
  name       String
  isSystem   Boolean   @map("is_system")
  presets    Presets[] @relation("PartOfScreen")
  targets    Presets[] @relation("PresetGoesToScreen")
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int

  @@map("screens")
}

model Presets {
  id       Int      @id @default(autoincrement())
  type     String
  title    String?
  subtitle String?
  image    String?
  cta      String?
  position Int
  screen   Screens  @relation("PartOfScreen", fields: [screenId], references: [id])
  screenId Int      @map("screen_id")
  target   Screens? @relation("PresetGoesToScreen", fields: [targetId], references: [id])
  targetId Int?     @map("target_id")

  @@map("presets")
}
