// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchants {
  id                      Int                      @id @default(autoincrement())
  username                String                   @unique
  password                String
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  email                   String
  screens                 Screens[]
  wooCommerceKeys         WooCommerceKeys[]
  users                   Users[]
  userActions             UserActions[]
  recommendationsSettings RecommendationsSettings?

  @@map("merchants")
}

model Users {
  id          Int           @id @default(autoincrement())
  password    String
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  email       String        @unique
  merchant    Merchants     @relation(fields: [merchantId], references: [id])
  merchantId  Int           @map("merchant_id")
  UserActions UserActions[]

  @@map("users")
}

model WooCommerceKeys {
  id         Int       @id @default(autoincrement())
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int       @map("merchant_id")
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")

  @@map("woo_commerce_keys")
}

model Screens {
  id         Int       @id @default(autoincrement())
  name       String
  isSystem   Boolean   @map("is_system")
  presets    Presets[] @relation("PartOfScreen")
  targets    Presets[] @relation("PresetGoesToScreen")
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int       @map("merchant_id")

  @@map("screens")
}

model Presets {
  id       Int      @id @default(autoincrement())
  type     String
  title    String?
  subtitle String?
  image    String?
  cta      String?
  position Int
  screen   Screens  @relation("PartOfScreen", fields: [screenId], references: [id])
  screenId Int      @map("screen_id")
  target   Screens? @relation("PresetGoesToScreen", fields: [targetId], references: [id])
  targetId Int?     @map("target_id")

  @@map("presets")
}

enum UserActionType {
  VIEW
  FAVORITE
  ADD_TO_CART
  ORDER
}

model UserActions {
  id         Int            @id @default(autoincrement())
  action     UserActionType
  productId  Int            @map("product_id")
  user       Users          @relation(fields: [userId], references: [id])
  userId     Int            @map("user_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  merchant   Merchants      @relation(fields: [merchantId], references: [id])
  merchantId Int            @map("merchant_id")

  @@map("user_actions")
}

model RecommendationsSettings {
  id               Int       @id @default(autoincrement())
  view             Int
  favorite         Int
  cart             Int
  order            Int
  view_timeout     Int
  show_after_order Boolean
  merchant         Merchants @relation(fields: [merchantId], references: [id])
  merchantId       Int       @unique @map("merchant_id")

  @@map("recommendations_settings")
}
