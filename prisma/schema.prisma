// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchants {
  id                      Int                      @id @default(autoincrement())
  username                String                   @unique
  password                String
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  email                   String
  screens                 Screens[]
  wooCommerceKeys         WooCommerceKeys[]
  users                   Users[]
  userActions             UserActions[]
  recommendationsSettings RecommendationsSettings?
  Orders                  Orders[]
  BuildSettings           BuildSettings[]

  @@map("merchants")
}

model Users {
  id          Int           @id @default(autoincrement())
  password    String
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  email       String        @unique
  phone       String?
  merchant    Merchants     @relation(fields: [merchantId], references: [id])
  merchantId  Int           @map("merchant_id")
  UserActions UserActions[]
  Addresses   Addresses[]
  Orders      Orders[]

  @@map("users")
}

model WooCommerceKeys {
  id         Int       @id @default(autoincrement())
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int       @map("merchant_id")
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")

  @@map("woo_commerce_keys")
}

model Screens {
  id         Int       @id @default(autoincrement())
  name       String
  isSystem   Boolean   @map("is_system")
  presets    Presets[] @relation("PartOfScreen")
  targets    Presets[] @relation("PresetGoesToScreen")
  merchant   Merchants @relation(fields: [merchantId], references: [id])
  merchantId Int       @map("merchant_id")

  @@map("screens")
}

model Presets {
  id       Int      @id @default(autoincrement())
  type     String
  title    String?
  subtitle String?
  image    String?
  cta      String?
  position Int
  screen   Screens  @relation("PartOfScreen", fields: [screenId], references: [id])
  screenId Int      @map("screen_id")
  target   Screens? @relation("PresetGoesToScreen", fields: [targetId], references: [id])
  targetId Int?     @map("target_id")

  @@map("presets")
}

enum UserActionType {
  VIEW
  FAVORITE
  ADD_TO_CART
  ORDER
}

model UserActions {
  id         Int            @id @default(autoincrement())
  action     UserActionType
  productId  Int            @map("product_id")
  user       Users          @relation(fields: [userId], references: [id])
  userId     Int            @map("user_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  merchant   Merchants      @relation(fields: [merchantId], references: [id])
  merchantId Int            @map("merchant_id")

  @@map("user_actions")
}

model RecommendationsSettings {
  id               Int       @id @default(autoincrement())
  view             Int
  favorite         Int
  cart             Int
  order            Int
  view_timeout     Int
  show_after_order Boolean
  merchant         Merchants @relation(fields: [merchantId], references: [id])
  merchantId       Int       @unique @map("merchant_id")

  @@map("recommendations_settings")
}

model Addresses {
  id       Int      @id @default(autoincrement())
  isActive Boolean  @default(false) @map("is_active")
  country  String
  city     String
  address1 String
  postcode String
  address2 String?
  user     Users    @relation(fields: [userId], references: [id])
  userId   Int      @map("user_id")
  Orders   Orders[]

  @@map("addresses")
}

model OrderedProducts {
  id          Int    @id @default(autoincrement())
  variationId Int?   @map("variation_id")
  productId   Int    @map("product_id")
  quantity    Int
  order       Orders @relation(fields: [orderId], references: [id])
  orderId     Int    @map("order_id")

  @@map("ordered_products")
}

model Orders {
  id              Int               @id @default(autoincrement())
  address         Addresses?        @relation(fields: [addressId], references: [id])
  addressId       Int?              @map("address_id")
  user            Users             @relation(fields: [userId], references: [id])
  userId          Int               @map("user_id")
  merchant        Merchants         @relation(fields: [merchantId], references: [id])
  merchantId      Int               @map("merchant_id")
  externalId      Int               @map("external_id")
  totalPrice      Float             @map("total_price")
  OrderedProducts OrderedProducts[]
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("orders")
}

model BuildSettings {
  id            Int       @id @default(autoincrement())
  appName       String?   @map("app_name")
  packageName   String?   @map("package_name")
  splashImage   String?   @map("splash_image")
  adaptiveImage String?   @map("adaptive_image")
  merchant      Merchants @relation(fields: [merchantId], references: [id])
  merchantId    Int       @unique @map("merchant_id")

  @@map("build_settings")
}
